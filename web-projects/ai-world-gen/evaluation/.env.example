# Copy this file to `.env` in the same folder and fill it in. `.env` is git-ignored;
# evaluate.py reads it at start and never overrides a variable that is already set.

# Required for `run`: pays for the generation (Jev decisions, and the narrative model
# only for a test case without a preset). Create one at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-paste-your-key-here

# Optional: the Galtea key (gsk_...). When empty, the key stored by `galtea login` is used.
GALTEA_API_KEY=

# The Galtea product. `setup` writes the id it created or found into `galtea.json`, which
# is committed and is what `run` and `report` read. Set this only to make `setup` adopt an
# existing product instead of matching by name (for example after a rename).
GALTEA_PRODUCT_ID=

# Optional, first `setup` only: the organization that owns a product `setup` has to create.
# When empty, the organization that holds most of the key's products is used.
GALTEA_ORGANIZATION_ID=

# The models, pinned to exact versions so every run of the evaluation is comparable even
# after OpenRouter adds newer ones. The page itself defaults to the moving alias
# `~typesafe/jev-latest`; the evaluation must not. Both are written into the Galtea version.
AI_WORLD_GEN_DECISION_MODEL=typesafe/jev-1.13
AI_WORLD_GEN_NARRATIVE_MODEL=anthropic/claude-sonnet-5
# The model Galtea's own evaluator uses for the judge metric (one of `galtea evaluator-models list`).
AI_WORLD_GEN_JUDGE_MODEL=GPT-5.2
